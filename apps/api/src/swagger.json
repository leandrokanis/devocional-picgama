{
  "openapi": "3.0.0",
  "info": {
    "title": "Devocional WhatsApp Bot API",
    "description": "API para envio automatizado de devocionais via WhatsApp e gerenciamento operacional.",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local server"
    }
  ],
  "paths": {
    "/": { "get": { "summary": "API root", "responses": { "200": { "description": "API metadata" } } } },
    "/health": { "get": { "summary": "Health check", "responses": { "200": { "description": "Service health" } } } },
    "/api-docs": { "get": { "summary": "OpenAPI specification", "responses": { "200": { "description": "OpenAPI JSON" } } } },
    "/docs": { "get": { "summary": "Swagger UI", "responses": { "200": { "description": "Swagger UI HTML" } } } },
    "/send": { "post": { "summary": "Send today's devotional", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Send succeeded" }, "401": { "description": "Unauthorized" }, "500": { "description": "Send failed" } } } },
    "/readings/today": { "get": { "summary": "Get today's reading", "responses": { "200": { "description": "Today's reading, read from the database", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DevotionalReading" } } } }, "404": { "description": "Reading not found" } } } },
    "/readings": { "get": { "summary": "List readings", "description": "Readings stored in the database, ordered by date. `from` and `to` filter an inclusive date range (either may be omitted); `date` is a shorthand for from = to = date. Each item has `audio`: { originalName, sizeBytes, updatedAt } when the date has an attached voice note, or null.", "parameters": [{ "name": "from", "in": "query", "required": false, "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } }, { "name": "to", "in": "query", "required": false, "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } }, { "name": "date", "in": "query", "required": false, "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } }], "responses": { "200": { "description": "Readings list", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/DevotionalReading" } }, "metadata": { "type": "object" } } } } } } } }, "post": { "summary": "Create a scheduled reading", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReadingInput" } } } }, "responses": { "201": { "description": "Reading created", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/DevotionalReading" } } } } } }, "400": { "description": "Invalid body, date or empty passage", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }, "409": { "description": "A reading already exists for this date", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } } } } },
    "/readings/import": { "post": { "summary": "Import readings from a JSON list", "description": "Body is a JSON array. Items in the new format `{date, passage, title?, description?, link?}` or the old one `{date, reading}` (passage = reading; title, description and link empty). Invalid items, dates that already exist and dates repeated in the list (after the first) are skipped. Existing readings are never overwritten.", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object" } } } } }, "responses": { "200": { "description": "Import summary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ImportResult" } } } }, "400": { "description": "Body is not a JSON array; nothing is created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } } } } },
    "/readings/{date}": { "parameters": [{ "name": "date", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } }], "get": { "summary": "Get one scheduled reading", "description": "Public, like GET /readings. Returns the reading with its audio metadata (or null) and its status.", "responses": { "200": { "description": "The reading of this date", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/DevotionalReading" } } } } } }, "404": { "description": "No reading for this date", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } } } }, "put": { "summary": "Edit a scheduled reading", "description": "Replaces passage, title, description and link. Send `date` in the body to move the reading to another date; its audio moves along. Moving onto a date that has a reading, or a reading with audio onto a date that already has another audio, is a 409 and nothing changes.", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/ReadingInput" }], "description": "`date` is optional here" } } } }, "responses": { "200": { "description": "Reading updated", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/DevotionalReading" } } } } } }, "400": { "description": "Invalid body, date or empty passage", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }, "404": { "description": "No reading for this date", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }, "409": { "description": "Target date already has a reading or another audio", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } } } }, "delete": { "summary": "Delete a scheduled reading and its audio", "security": [{ "bearerAuth": [] }], "responses": { "204": { "description": "Reading and audio (record and file) deleted" }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }, "404": { "description": "No reading for this date", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } } } } },
    "/readings/{date}/audio": {
      "parameters": [{ "name": "date", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } }],
      "put": { "summary": "Attach or replace the devotional audio of a date", "description": "Multipart upload of an mp3 (field `file`, `.mp3` or `audio/mpeg`) up to AUDIO_MAX_UPLOAD_MB (default 15 MB). Converted to ogg/opus and sent as a WhatsApp voice note.", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string", "format": "binary" } } } } } }, "responses": { "200": { "description": "Audio stored", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/DevotionalAudio" } } } } } }, "400": { "description": "Not an mp3, missing file or conversion failed" }, "401": { "description": "Unauthorized" }, "404": { "description": "No reading for this date" }, "413": { "description": "File above the size limit" } } },
      "get": { "summary": "Download the voice note (audio/ogg) of a date", "description": "Accepts the token as Bearer header or `?token=` query parameter (for <audio> players).", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "token", "in": "query", "required": false, "schema": { "type": "string" } }], "responses": { "200": { "description": "Voice note", "content": { "audio/ogg": { "schema": { "type": "string", "format": "binary" } } } }, "401": { "description": "Unauthorized" }, "404": { "description": "No audio for this date" } } },
      "delete": { "summary": "Remove the devotional audio of a date", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Audio removed" }, "401": { "description": "Unauthorized" }, "404": { "description": "No audio for this date" } } }
    },
    "/qr": { "get": { "summary": "Get WhatsApp QR status", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "QR status" }, "401": { "description": "Unauthorized" } } } },
    "/scheduler/status": { "get": { "summary": "Get scheduler status", "responses": { "200": { "description": "Scheduler status" } } } },
    "/scheduler/start": { "post": { "summary": "Start scheduler", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Scheduler started" }, "401": { "description": "Unauthorized" } } } },
    "/scheduler/stop": { "post": { "summary": "Stop scheduler", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Scheduler stopped" }, "401": { "description": "Unauthorized" } } } },
    "/api/recipients": { "get": { "summary": "List recipients", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Recipients list" } } }, "post": { "summary": "Create recipient", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Recipient created" }, "400": { "description": "Invalid payload" }, "409": { "description": "Conflict" } } } },
    "/api/recipients/{id}": {
      "get": { "summary": "Get recipient by ID", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Recipient" }, "404": { "description": "Not found" } } },
      "put": { "summary": "Update recipient", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Recipient updated" }, "400": { "description": "Invalid payload" }, "404": { "description": "Not found" } } },
      "delete": { "summary": "Delete recipient", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Recipient deleted" }, "404": { "description": "Not found" } } }
    },
    "/api/recipients/{id}/send": { "post": { "summary": "Send today's devotional to recipient", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Devotional sent" }, "401": { "description": "Unauthorized" }, "404": { "description": "Recipient not found" }, "500": { "description": "Send failed" } } } }
  },
  "components": {
    "schemas": {
      "DevotionalAudio": { "type": "object", "properties": { "originalName": { "type": "string" }, "sizeBytes": { "type": "integer" }, "durationSeconds": { "type": "integer", "nullable": true, "description": "Length of the uploaded mp3 in whole seconds, read from ffmpeg. Null for audios uploaded before this was measured, or when ffmpeg did not report it." }, "updatedAt": { "type": "string", "format": "date-time" } } },
      "DevotionalReading": { "type": "object", "properties": { "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "passage": { "type": "string" }, "title": { "type": "string", "description": "Episode title, stored exactly as typed. Empty string when the devotional is not ready; without a title the second message is not sent." }, "description": { "type": "string" }, "link": { "type": "string", "description": "Episode link (e.g. Spotify). The BibleGateway link of message 1 is generated from the passage." }, "audio": { "allOf": [{ "$ref": "#/components/schemas/DevotionalAudio" }], "nullable": true }, "status": { "type": "string", "enum": ["ready", "pending"], "description": "ready when the reading has a non-blank title and an audio; pending otherwise." }, "updatedAt": { "type": "string", "format": "date-time", "description": "When the reading was last saved." } } },
      "ReadingInput": { "type": "object", "required": ["date", "passage"], "properties": { "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "A real calendar date" }, "passage": { "type": "string", "minLength": 1 }, "title": { "type": "string", "default": "" }, "description": { "type": "string", "default": "" }, "link": { "type": "string", "default": "" } } },
      "ImportResult": { "type": "object", "properties": { "success": { "type": "boolean" }, "imported": { "type": "integer" }, "skipped": { "type": "integer" } } },
      "Error": { "type": "object", "properties": { "success": { "type": "boolean", "example": false }, "error": { "type": "string" } } }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Token"
      }
    }
  }
}
